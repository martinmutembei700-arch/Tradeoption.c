const express = require("express");

const app = express();
const PORT = process.env.PORT || 3000;

app.get("/", (req, res) => {
res.send("Martin Trade market data server is running!");
});

app.get("/api/quote/:symbol", async (req, res) => {
const token = process.env.FINNHUB_API_KEY;
const symbol = req.params.symbol.toUpperCase();

const allowedSymbols = [
"AAPL", "MSFT", "NVDA",
"TSLA", "AMZN", "GOOGL"
];

if (!allowedSymbols.includes(symbol)) {
return res.status(400).json({ error: "Unsupported stock symbol" });
}

if (!token) {
return res.status(500).json({ error: "Market data API key is not configured" });
}

try {
const url = "https://finnhub.io/api/v1/quote?symbol=${symbol}&token=${token}";
const response = await fetch(url);
const data = await response.json();

if (!response.ok || !data.c) {
  return res.status(502).json({ error: "Market quote unavailable" });
}

res.json({
  symbol,
  price: data.c,
  previousClose: data.pc,
  change: data.d,
  percentChange: data.dp,
  timestamp: data.t
});

} catch (error) {
res.status(500).json({ error: "Unable to retrieve market data" });
}
});

app.listen(PORT, () => {
console.log("Martin Trade server running on port ${PORT}");
});
